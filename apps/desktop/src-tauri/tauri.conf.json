{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtyDog",
  "version": "0.2.1",
  "identifier": "com.acidtib.artydog",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArtyDog",
        "width": 382,
        "height": 477,
        "resizable": false,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "ArtyDog - Overlay",
        "url": "overlay.html",
        "width": 382,
        "height": 444,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRjFEQTlFRkExNDRENTgKUldSWVRSVDZudHJ4b0hiTTBBRDhYVUhoZ3lZNVMrc21Ma0JJK0RLVkVWYzFoN2JidUJTRDlLT2kK",
      "endpoints": [
        "https://github.com/acidtib/artydog/releases/latest/download/latest.json"
      ]
    }
  }
}
