{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set (Phase 1: overlay proof of concept).",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    {
      "identifier": "core:window:allow-close",
      "allow": [{ "label": "main" }]
    },
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart"
  ]
}
