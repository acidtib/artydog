{
  "name": "@artydog/website",
  "private": true,
  "version": "0.0.0",
  "description": "ArtyDog landing site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
