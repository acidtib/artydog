{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtyDog",
  "version": "0.1.1",
  "identifier": "com.acidtib.artydog",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArtyDog",
        "width": 900,
        "height": 700,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "ArtyDog - Overlay",
        "url": "overlay.html",
        "width": 400,
        "height": 300,
        "minWidth": 280,
        "minHeight": 200,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRjFEQTlFRkExNDRENTgKUldSWVRSVDZudHJ4b0hiTTBBRDhYVUhoZ3lZNVMrc21Ma0JJK0RLVkVWYzFoN2JidUJTRDlLT2kK",
      "endpoints": [
        "https://github.com/acidtib/potato/releases/latest/download/latest.json"
      ]
    }
  }
}
