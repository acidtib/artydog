{
  "name": "artydog",
  "private": true,
  "description": "ArtyDog - Instant firing solutions in WARDOGS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @artydog/desktop dev",
    "dev:web": "pnpm --filter @artydog/website dev",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "tauri": "pnpm --filter @artydog/desktop tauri",
    "release:patch": "node scripts/bump.mjs patch",
    "release:minor": "node scripts/bump.mjs minor",
    "release:major": "node scripts/bump.mjs major"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript-eslint": "^8.14.0"
  },
  "packageManager": "pnpm@11.22.0"
}
